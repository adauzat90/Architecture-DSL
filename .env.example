# Copy to .env and fill in, or export in your shell.
# Required only for the agentic workflow (`barndsl design ...`).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: point the agent at a custom endpoint (a proxy, gateway, or a
# self-hosted Anthropic-compatible API). Leave unset for the default
# https://api.anthropic.com.
# ANTHROPIC_BASE_URL=https://my-proxy.example.com
